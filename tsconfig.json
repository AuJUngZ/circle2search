{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "webextension-polyfill"],
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["src", "tests", "scripts", "manifests"]
}
